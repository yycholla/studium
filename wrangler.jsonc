{
  "name": "studium",
  "compatibility_date": "2026-10-10",
  "observability": {
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth/*",
      "/api/auth/*",
      "/api/field-notes/*",
      "/api/groups/*"
    ]
  },
  "routes": [
    {
      "pattern": "studium.yycholla.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  "vars": {
    "SITE_ORIGIN": "https://studium.yycholla.com",
    "XIVAUTH_CLIENT_ID": "ZDV-uUXNHToUDAhbSdIjQEs7wZIT2QcZzRZOsRujU78"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studium",
      "database_id": "b7e5a6b6-09d7-44fa-90a2-c7a2b7450b26",
      "migrations_dir": "migrations",
      "remote": true
    }
  ]
}
