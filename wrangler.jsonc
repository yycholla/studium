{
  "name": "studium",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth/*",
      "/api/auth/*"
    ]
  },
  "routes": [
    {
      "pattern": "studium.yycholla.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  "vars": {
    "SITE_ORIGIN": "https://studium.yycholla.com"
  }
}
